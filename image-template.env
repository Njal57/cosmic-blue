# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=cosmic-blue

# Make this the same as your github username/organisation
REPO_ORGANIZATION="cosmic-blue-os"

IMAGE_DESC="Bluefin-like Universal Blue image with the COSMIC desktop"
IMAGE_KEYWORDS="bootc,oci,linux,cosmic,ublue,bluefin"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://raw.githubusercontent.com/cosmic-blue-os/cosmic-blue/main/branding/logo/cosmic-blue-logo.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
