{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Etc/UTC",

  // Merge non-major updates once every check of the pull request is green
  // (image build + VM boot test). Renovate merges them itself:
  // GitHub's native auto-merge would merge at once, as main has no required
  // status checks.
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,

  "packageRules": [
    {
      // Base images are rebuilt every day (ublue-os/base-main around 01:10
      // and 04:10 UTC): one grouped pull request at 04:00-04:59 UTC. Its
      // merge (after ~1 hour of CI) builds the image, and the daily build of
      // build.yml then sees a recent build and skips.
      "description": "Container images in the Containerfile",
      "matchManagers": ["dockerfile"],
      "groupName": "base images",
      "schedule": ["* 4 * * *"]
    },
    {
      "description": "GitHub Actions, once a week",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions",
      "schedule": ["* 0-7 * * 1"]
    },
    {
      // Moving to a new Fedora release is a deliberate choice (see the
      // Containerfile): never propose it.
      "description": "Stay on the current Fedora release",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/ublue-os/base-main",
        "registry.fedoraproject.org/fedora"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Tela circle icons (no releases: latest master commit), once a week",
      "matchDepNames": ["https://github.com/vinceliuice/Tela-circle-icon-theme.git"],
      "groupName": "Tela circle icons",
      "schedule": ["* 0-7 * * 1"]
    },
    {
      // Major versions can break the build: open the pull request, a human
      // merges it.
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],

  // Tela circle is fetched by git at a pinned commit in
  // build_files/icon_theme/tela.sh, the Bibata cursors at a pinned tag in
  // build_files/cursor_theme/bibata.sh
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/icon_theme/tela\\.sh$/"],
      "matchStrings": [
        "TELA_REPO=\"(?<depName>[^\"]+)\"\\s+TELA_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "master"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/cursor_theme/bibata\\.sh$/"],
      "matchStrings": [
        "BIBATA_REPO=\"https://github\\.com/(?<depName>[^\"]+)\\.git\"\\s+BIBATA_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ],

  // libcosmic follows the Fedora COSMIC packages through
  // .github/workflows/check-cosmic-version.yml, not Renovate.
  "cargo": { "enabled": false }
}
