{"$schema":"https://docs.renovatebot.com/renovate-schema.json","extends":["config:best-practices"],"timezone":"Etc/UTC","automerge":true,"automergeType":"pr","platformAutomerge":false,"packageRules":[{"description":"Container images in the Containerfile","matchManagers":["dockerfile"],"groupName":"base images","schedule":["* 4 * * *"]},{"description":"GitHub Actions, once a week","matchManagers":["github-actions"],"matchUpdateTypes":["minor","patch","digest","pin","pinDigest"],"groupName":"GitHub Actions","schedule":["* 0-7 * * 1"]},{"description":"Stay on the current Fedora release","matchDatasources":["docker"],"matchPackageNames":["ghcr.io/ublue-os/base-main","registry.fedoraproject.org/fedora"],"matchUpdateTypes":["major"],"enabled":false},{"description":"Tela circle icons (no releases: latest master commit), once a week","matchDepNames":["https://github.com/vinceliuice/Tela-circle-icon-theme.git"],"groupName":"Tela circle icons","schedule":["* 0-7 * * 1"]},{"matchUpdateTypes":["major"],"automerge":false}],"customManagers":[{"customType":"regex","managerFilePatterns":["/^build_files/icon_theme/tela\\.sh$/"],"matchStrings":["TELA_REPO=\"(?<depName>[^\"]+)\"\\s+TELA_COMMIT=\"(?<currentDigest>[0-9a-f]{40})\""],"datasourceTemplate":"git-refs","currentValueTemplate":"master"}],"cargo":{"enabled":false}}